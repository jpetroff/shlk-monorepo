{
    "manifest_version": 3,
    "version": "2.1.1",
    "name": "shlk.cc \u2014 copy and create shortlinks",
    "icons": {
        "128": "/assets/favicon/chrome_extension_icon.png"
    },
    "permissions": [
        "tabs",
        "clipboardRead",
        "clipboardWrite",
        "alarms",
        "storage",
        "notifications"
    ],
    "optional_permissions": [],
    "host_permissions": [],
    "action": {
        "default_popup": "index.html",
        "default_icon": "/assets/favicon/chrome_extension_icon.png"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Shift+S",
                "mac": "Option+Shift+S"
            },
            "description": "Open share link extension popup to shorten URL or snooze it"
        }
    },
    "description": "Create and copy short links, manage your saved links, and snooze tabs to reopen them later."
}
