{
  "name": "@shlk/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode webapp",
    "dev:extension": "bun run dev:extension:chrome",
    "build": "bun run build:web && bun run build:extensions",
    "build:web": "NODE_ENV=production vite build --mode webapp",
    "build:extension": "bun run build:extension:chrome",
    "lint": "bun run --cwd ../../tools/lint lint:web",
    "typecheck": "bunx tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:extension:chrome": "SHLK_EXTENSION_BROWSER=chrome NODE_ENV=development vite build --mode extension-development --watch",
    "dev:extension:firefox": "SHLK_EXTENSION_BROWSER=firefox NODE_ENV=development vite build --mode extension-development --watch",
    "build:extension:chrome": "SHLK_EXTENSION_BROWSER=chrome NODE_ENV=production vite build --mode extension",
    "build:extension:firefox": "SHLK_EXTENSION_BROWSER=firefox NODE_ENV=production vite build --mode extension",
    "build:extensions": "bun run build:extension:chrome && bun run build:extension:firefox"
  },
  "dependencies": {
    "classnames": "2.5.1",
    "dayjs": "1.11.21",
    "graphiql": "5.2.4",
    "graphql": "17.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "react-transition-group": "4.4.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/react-transition-group": "4.4.12",
    "@vitejs/plugin-react": "6.0.4",
    "chrome-types": "0.1.436",
    "jsdom": "^30.0.1",
    "less": "4.8.1",
    "vite": "8.1.5",
    "vite-plugin-svgr": "5.2.0",
    "vitest": "^4.1.10"
  }
}
