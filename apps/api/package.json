{
  "name": "@shlk/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:extension": "bun --watch src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "build": "bun run typecheck",
    "lint": "bun run --cwd ../../tools/lint lint:api",
    "typecheck": "bunx tsc -p tsconfig.json",
    "test": "bun run --cwd ../.. test:api",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "bun src/db/migrate.ts",
    "db:import:mongo": "bun --preload ./src/bun-compat.ts scripts/import-mongo-to-sqlite.ts"
  },
  "dependencies": {
    "@graphql-tools/merge": "9.2.2",
    "@graphql-tools/schema": "10.0.38",
    "axios": "1.18.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "google-auth-library": "10.9.1",
    "googleapis": "173.0.0",
    "graphql": "17.0.2",
    "helmet": "8.3.0",
    "node-html-parser": "9.0.1",
    "underscore": "1.13.8"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/underscore": "1.13.0",
    "drizzle-kit": "0.31.10",
    "mongodb": "7.5.0"
  }
}
