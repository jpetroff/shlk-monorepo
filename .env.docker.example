# Compose reads this file both for model interpolation and for the app
# container's runtime environment.
SHLK_ENV_FILE=.env.docker

# Compose tags the runtime image with these values. Use an immutable tag (for
# example, the Git commit SHA) when publishing a production release.
SHLK_IMAGE=ghcr.io/replace-with-owner/shlk
SHLK_IMAGE_TAG=replace-with-git-sha

# Host interface and port exposed by Compose.
APP_PORT=8002
BIND_ADDRESS=127.0.0.1

# Runtime configuration and secrets. WEB_RISK_API_KEY is optional; when blank,
# external destination threat checks are disabled.
APP_SESSION_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=https://shlk.example/oauth/google/callback
WEB_APP_URL=https://shlk.example
PUBLIC_SERVICE_URL=https://shlk.example
DISPLAY_SERVICE_URL=shlk.example
EXTENSION_ORIGIN=chrome-extension://replace-with-production-extension-id
TRUST_PROXY=1
WEB_RISK_API_KEY=

# VITE_* values are public and are embedded in the website/extension at build time.
VITE_BACKEND_URL=https://shlk.example
VITE_PUBLIC_SERVICE_URL=https://shlk.example
VITE_DISPLAY_SERVICE_URL=shlk.example
VITE_EXTENSION_STORE_URL=https://chrome.google.com/webstore/detail/shlkcc-url-shortener/bjkhbppdemdfngnceocjmeapcfckfkok
